class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int count=0,maxCount=0;
        for(int i=0; i<nums.length;i++){
            while(i<nums.length && nums[i]!=0){
                count++;
                i++;
            }
            maxCount=Math.max(count,maxCount);
            count=0;
        }
        return maxCount;
    }
}
