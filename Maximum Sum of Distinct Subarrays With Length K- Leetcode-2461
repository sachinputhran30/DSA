class Solution {
    public long maximumSubarraySum(int[] nums, int k) {
         HashSet<Integer> set=new HashSet<>();
         int left=0;
         long sum=0,maxSum=0;
         for(int i=0; i<nums.length; i++){
            while(set.contains(nums[i]) || i-left+1>k){
                set.remove(nums[left]);
                sum-=nums[left];
                left++;
            }
            set.add(nums[i]);
            sum+=nums[i];
            if(i-left+1==k){
                maxSum=Math.max(maxSum,sum);
            }
         }
         return maxSum;
    }
}
